import { LineEdit, Button, ScrollView, ComboBox } from "std-widgets.slint";
import { RangeSlider } from "range_slider.slint";

export struct Tile {
    path: string,
    image: image,
    size-kb: int,
    index: int,
}

export component MainWindow inherits Window {
    title: "imgfind";
    preferred-width: 1100px;
    preferred-height: 800px;
    background: #1f2430;

    // Properties set from Rust.
    in property <[Tile]> tiles;
    in property <int> total-items;
    in property <string> status;
    in property <bool> can-search: false;
    // Two-way-bound to the search field's text so Rust can pre-fill it on
    // session restore. Setting it does NOT trigger `search` — that callback
    // fires only on the LineEdit's `accepted` (Enter).
    in-out property <string> query-text;

    // Lightbox state set from Rust.
    in property <bool> lightbox-open: false;
    in property <image> lightbox-image;

    // Detail panel state set from Rust.
    in property <bool> detail-open: false;
    in property <image> detail-image;
    in property <string> detail-filename;
    in property <string> detail-meta;

    // Filter-bar properties (set from Rust; UI emits changes via callbacks below).
    in-out property <float> size-lo: 0.0;
    in-out property <float> size-hi: 1.0;
    in property <string> size-label;
    // Struct model: each chip carries its name and selected state.  Rust pushes
    // the full list; the UI calls ext-toggled(name) on click so Rust can toggle.
    in property <[{name: string, on: bool}]> type-chips;
    // 0 = Any, 1 = Has GPS, 2 = No GPS.
    in property <int> gps-mode: 0;

    callback search(string);
    callback tile-selected(int);
    callback tile-activated(int);
    callback tile-open-external(int);
    callback detail-close();
    callback search-similar();
    callback detail-view-full();
    callback lightbox-close();
    callback lightbox-prev();
    callback lightbox-next();
    // Filter-bar callbacks.
    callback filters-changed();
    callback ext-toggled(string);
    callback gps-mode-changed(int);

    // Sort selector (set from Rust; see sort-changed / sort-dir-toggled callbacks).
    // ASCII "Asc"/"Desc" for the direction button — no arrow glyphs (tofu in Slint's default font).
    in property <[string]> sort-options;
    in-out property <int> sort-index: 0;
    in property <bool> sort-desc: false;
    callback sort-changed();
    callback sort-dir-toggled();

    // Keyboard-navigation selection: index into `tiles` of the highlighted tile,
    // or -1 for none. Driven by Rust (mouse click + grid-nav handler).
    in property <int> selected-index: -1;
    // dir encoding: 0=Left, 1=Right, 2=Up, 3=Down. Second arg is the live column count.
    callback grid-nav(int, int);
    callback grid-open-detail();
    callback grid-open-lightbox();

    // Grid geometry constants.
    private property <length> tile-size: 200px;
    private property <length> tile-gap: 8px;
    private property <length> tile-stride: tile-size + tile-gap;
    // Number of columns that fit in the grid area (not root width — the panel
    // narrows the available space when open, so we bind to grid-area.width).
    // Exposed as `out` so Rust can read it for the T14 windowed loader.
    out property <int> cols: max(1, floor((grid-area.width - 16px) / tile-stride));
    // Total grid height: driven by total-items (full result set), not tiles.length
    // (the capped render window), so the scrollbar spans the complete library.
    private property <int> row-count: ceil(root.total-items / cols);
    private property <length> grid-height: row-count * tile-stride;
    // Scroll offset exposed for the T14 viewport-driven window loader, two-way
    // bound to the ScrollView below so Rust can ALSO restore it on session
    // launch (T20). NOTE the sign: viewport-y is <= 0 and grows MORE NEGATIVE as
    // you scroll down, so the Rust side negates it (`scroll_px = (-vy).max(0)`).
    in-out property <length> grid-viewport-y;
    // Visible height of the scroll viewport, for the T14 windowed loader's
    // `visible_rows` computation.
    out property <length> grid-viewport-h: grid-scroll.visible-height;

    // ALL keyboard shortcuts live in ONE place: the single `app-keys` FocusScope
    // below, which wraps the whole window and uses `capture-key-pressed`. Slint
    // offers each key event to ancestors (Window down to the focused element)
    // BEFORE delivering it to whatever currently has focus, so these shortcuts
    // fire no matter which control (tile, Button, slider) was last clicked — no
    // per-scope focus juggling, no focus pulses. The only gate is the search
    // field: while it has focus we let it type (Escape blurs back to app-keys).
    forward-focus: app-keys;

    // Keep the selected tile within the scroll viewport.
    changed selected-index => {
        if (root.selected-index >= 0) {
            // Inline expressions: tile-y, tile-bottom, top, bottom.
            if (floor(root.selected-index / root.cols) * root.tile-stride < -grid-scroll.viewport-y) {
                grid-scroll.viewport-y = -(floor(root.selected-index / root.cols) * root.tile-stride);
            } else if (floor(root.selected-index / root.cols) * root.tile-stride + root.tile-size > -grid-scroll.viewport-y + grid-scroll.visible-height) {
                grid-scroll.viewport-y = -(floor(root.selected-index / root.cols) * root.tile-stride + root.tile-size - grid-scroll.visible-height);
            }
        }
    }

    app-keys := FocusScope {
        // Hold focus from startup so key events flow; capture-key-pressed then
        // intercepts them for the whole subtree regardless of inner focus.
        init => { self.focus(); }

        capture-key-pressed(event) => {
            // While the search field is being typed in, let it have the keys
            // (Escape blurs it back to the app scope so navigation resumes).
            if (search-input.has-focus) {
                if (event.text == Key.Escape) {
                    app-keys.focus();
                    return accept;
                }
                return reject;
            }
            // The lightbox is modal: it owns the keyboard while open.
            if (root.lightbox-open) {
                if (event.text == Key.Escape) {
                    root.lightbox-close();
                    return accept;
                }
                if (event.text == Key.LeftArrow || event.text == "h" || event.text == "H") {
                    root.lightbox-prev();
                    return accept;
                }
                if (event.text == Key.RightArrow || event.text == "l" || event.text == "L") {
                    root.lightbox-next();
                    return accept;
                }
                return accept;
            }
            // Grid navigation.
            if (event.text == "h" || event.text == "H" || event.text == Key.LeftArrow) {
                root.grid-nav(0, root.cols);
                return accept;
            }
            if (event.text == "l" || event.text == "L" || event.text == Key.RightArrow) {
                root.grid-nav(1, root.cols);
                return accept;
            }
            if (event.text == "k" || event.text == "K" || event.text == Key.UpArrow) {
                root.grid-nav(2, root.cols);
                return accept;
            }
            if (event.text == "j" || event.text == "J" || event.text == Key.DownArrow) {
                root.grid-nav(3, root.cols);
                return accept;
            }
            if (event.text == Key.Return) {
                root.grid-open-detail();
                return accept;
            }
            if (event.text == " ") {
                root.grid-open-lightbox();
                return accept;
            }
            if (event.text == Key.Escape && root.detail-open) {
                root.detail-close();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            HorizontalLayout {
                spacing: 8px;
                search-input := LineEdit {
                    text <=> root.query-text;
                    placeholder-text: root.can-search ? "Search images..." : "Loading model...";
                    enabled: root.can-search;
                    // Return focus to app-keys after submitting so grid keys work.
                    accepted(text) => { root.search(text); app-keys.focus(); }
                }
            }

            // --- Filter bar ---
            HorizontalLayout {
                spacing: 12px;
                alignment: start;

                // Size range slider + label.
                RangeSlider {
                    width: 180px;
                    lo <=> root.size-lo;
                    hi <=> root.size-hi;
                    range-changed(lo, hi) => {
                        root.size-lo = lo;
                        root.size-hi = hi;
                        root.filters-changed();
                    }
                }
                Text {
                    text: root.size-label;
                    color: #9aa4b2;
                    vertical-alignment: center;
                }

                // File-type toggle chips (struct model: [{name, on}]).
                for chip in root.type-chips: Rectangle {
                    width: chip-label.preferred-width + 16px;
                    height: 24px;
                    border-radius: 4px;
                    background: chip.on ? #3a6 : #2d3446;
                    border-width: 1px;
                    border-color: chip.on ? #3a6 : #3a4255;

                    chip-label := Text {
                        text: chip.name;
                        color: chip.on ? #fff : #9aa4b2;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }

                    TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => { root.ext-toggled(chip.name); }
                    }
                }

                // GPS 3-way control: Any / Has GPS / No GPS.
                HorizontalLayout {
                    spacing: 2px;

                    Rectangle {
                        width: gps-any-text.preferred-width + 16px;
                        height: 24px;
                        border-radius: 4px;
                        background: root.gps-mode == 0 ? #3a6 : #2d3446;
                        border-width: 1px;
                        border-color: root.gps-mode == 0 ? #3a6 : #3a4255;
                        gps-any-text := Text {
                            text: "Any";
                            color: root.gps-mode == 0 ? #fff : #9aa4b2;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                        TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => { root.gps-mode-changed(0); }
                        }
                    }

                    Rectangle {
                        width: gps-has-text.preferred-width + 16px;
                        height: 24px;
                        border-radius: 4px;
                        background: root.gps-mode == 1 ? #3a6 : #2d3446;
                        border-width: 1px;
                        border-color: root.gps-mode == 1 ? #3a6 : #3a4255;
                        gps-has-text := Text {
                            text: "Has GPS";
                            color: root.gps-mode == 1 ? #fff : #9aa4b2;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                        TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => { root.gps-mode-changed(1); }
                        }
                    }

                    Rectangle {
                        width: gps-no-text.preferred-width + 16px;
                        height: 24px;
                        border-radius: 4px;
                        background: root.gps-mode == 2 ? #3a6 : #2d3446;
                        border-width: 1px;
                        border-color: root.gps-mode == 2 ? #3a6 : #3a4255;
                        gps-no-text := Text {
                            text: "No GPS";
                            color: root.gps-mode == 2 ? #fff : #9aa4b2;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                        TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => { root.gps-mode-changed(2); }
                        }
                    }
                }
            }

            // --- Sort bar ---
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Text {
                    text: "Sort:";
                    color: #9aa4b2;
                    vertical-alignment: center;
                }
                ComboBox {
                    model: root.sort-options;
                    current-index <=> root.sort-index;
                    selected(_) => { root.sort-changed(); }
                }
                // ASCII "Asc"/"Desc" — no arrow glyphs (tofu in the default Slint font).
                sort-dir-btn := TouchArea {
                    width: sort-dir-text.preferred-width + 16px;
                    height: 28px;
                    clicked => { root.sort-dir-toggled(); }
                    Rectangle {
                        background: sort-dir-btn.has-hover ? #3a4a65 : #2d3446;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: #3a4255;
                        width: 100%;
                        height: 100%;
                        sort-dir-text := Text {
                            text: root.sort-desc ? "Desc" : "Asc";
                            color: #e0e4ed;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Text {
                text: root.status;
                color: #9aa4b2;
                visible: root.status != "";
            }

            HorizontalLayout {
                spacing: 0px;
                vertical-stretch: 1;

                // Grid area — grows to fill all available width when panel is closed.
                grid-area := Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;

                    grid-scroll := ScrollView {
                        width: 100%;
                        height: 100%;
                        viewport-height: root.grid-height;
                        viewport-width: root.cols * root.tile-stride;
                        viewport-y <=> root.grid-viewport-y;

                        for tile in root.tiles: Rectangle {
                            // Position by global index so the tile lands in the
                            // correct row/col even when the window doesn't start
                            // at 0 (T14 will deliver a non-zero-offset slice).
                            x: mod(tile.index, root.cols) * root.tile-stride;
                            y: floor(tile.index / root.cols) * root.tile-stride;
                            width: root.tile-size;
                            height: root.tile-size;
                            border-radius: 6px;
                            clip: true;
                            background: #2d3446;
                            border-width: tile.index == root.selected-index ? 3px : 0px;
                            border-color: #5b8cff;

                            Image {
                                source: tile.image;
                                image-fit: cover;
                                width: 100%;
                                height: 100%;
                            }

                            TouchArea {
                                width: 100%;
                                height: 100%;
                                // Return keyboard focus to app-keys when the user
                                // clicks into the grid (e.g. after typing a query),
                                // so vim/arrow navigation works immediately.
                                clicked => { root.tile-selected(tile.index); app-keys.focus(); }
                                double-clicked => { root.tile-activated(tile.index); }
                                pointer-event(e) => {
                                    if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                                        root.tile-open-external(tile.index);
                                    }
                                }
                            }
                        }
                    }
                }

                // Detail panel — fixed 340 px, only present when detail-open.
                if root.detail-open: Rectangle {
                    width: 340px;
                    background: #252b3a;

                    // Left border divider rendered as a thin child rectangle.
                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: 1px;
                        height: parent.height;
                        background: #3a4255;
                    }

                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        HorizontalLayout {
                            alignment: end;
                            Button {
                                // U+00D7 (×, Latin-1) renders in Slint's default font;
                                // the previous ✕ (U+2715) had no glyph and showed as tofu.
                                text: "×";
                                clicked => { root.detail-close(); app-keys.focus(); }
                            }
                        }

                        Image {
                            source: root.detail-image;
                            image-fit: contain;
                            height: 300px;
                        }

                        Text {
                            text: root.detail-filename;
                            color: #e0e4ed;
                            font-size: 13px;
                            wrap: word-wrap;
                        }

                        Text {
                            text: root.detail-meta;
                            color: #9aa4b2;
                            font-size: 12px;
                            wrap: word-wrap;
                        }

                        Button {
                            text: "View full";
                            // Opens the lightbox for the seed image by path, not by
                            // grid index, so it stays valid after a similar-search
                            // replaces the tile grid.
                            clicked => { root.detail-view-full(); app-keys.focus(); }
                        }

                        Button {
                            text: "Search similar";
                            clicked => { root.search-similar(); app-keys.focus(); }
                        }
                    }
                }
            }
        }

        // --- Lightbox overlay ---
        // Pure visuals + TouchAreas, NO FocusScope of its own — app-keys'
        // capture-key-pressed handles Esc / h / l / arrows while it's open.
        // Nav uses TouchArea (a Button would steal keyboard focus on click).
        if root.lightbox-open: Rectangle {
            width: root.width;
            height: root.height;

            Rectangle {
                background: #000000dd;
                width: 100%;
                height: 100%;
            }

            // Click anywhere (including the photo) to close. Below the nav arrows
            // in z-order, so the arrows win their 60px edge strips.
            TouchArea {
                width: 100%;
                height: 100%;
                clicked => { root.lightbox-close(); }
            }

            Image {
                source: root.lightbox-image;
                image-fit: contain;
                width: 90%;
                height: 90%;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            // Prev / next arrows as TouchAreas pinned to the left/right edges.
            prev-touch := TouchArea {
                width: 60px;
                height: 100%;
                x: 0;
                y: 0;
                clicked => { root.lightbox-prev(); }
                Rectangle {
                    background: prev-touch.has-hover ? #00000080 : transparent;
                    width: 100%;
                    height: 100%;
                    // ASCII < / > render in the default font; ‹ › (U+2039/203A) tofu.
                    Text {
                        text: "<";
                        color: white;
                        font-size: 28px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            next-touch := TouchArea {
                width: 60px;
                height: 100%;
                x: root.width - self.width;
                y: 0;
                clicked => { root.lightbox-next(); }
                Rectangle {
                    background: next-touch.has-hover ? #00000080 : transparent;
                    width: 100%;
                    height: 100%;
                    Text {
                        text: ">";
                        color: white;
                        font-size: 28px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
