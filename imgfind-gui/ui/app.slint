import { LineEdit, Button, ScrollView, ComboBox, Slider } from "std-widgets.slint";
import { RangeSlider } from "range_slider.slint";
// Tag widgets imported here once; do not re-import in other blocks (Slint
// errors on duplicate imports from the same path).
import { Toggle } from "toggle.slint";
import { TagEditor } from "tag_editor.slint";
// Re-exported so Rust gets a `MainWindow::global::<TagWrap>()` accessor to
// register the wrap_tag_rows bridge once at startup.
import { TagWrap } from "tag_wrap.slint";
export { TagWrap }

export struct Tile {
    path: string,
    image: image,
    size-kb: int,
    index: int,
    selected: bool,
}

// One left-rail color brush row. Index-aligned with `colors::BrushColor`.
export struct BrushRow {
    letter: string,
    color: color,
    tags: [string],
    joined: string,
}

// One labeled progress row in the background-processing status panel: a caption,
// a "done / total" readout, and a proportional fill bar. ASCII text only (Slint's
// default font has no glyph for many symbols — §1 of the slint skill).
component ProcessBar inherits VerticalLayout {
    in property <string> label;
    in property <int> done;
    in property <int> total;
    spacing: 4px;
    // Pack to natural height: label sits tight (4px) above its bar. Without this
    // the row stretches to fill the panel and the slack lands *between* label and
    // bar, butting the next item's label against this bar. Inter-item spacing is
    // owned by the wrapping VerticalLayout, slack by a single bottom spacer.
    vertical-stretch: 0;
    HorizontalLayout {
        Text {
            text: root.label;
            color: #cfd6e4;
            font-size: 12px;
        }
        Rectangle { horizontal-stretch: 1; }
        Text {
            text: "\{root.done} / \{root.total}";
            color: #9aa4b2;
            font-size: 12px;
        }
    }
    Rectangle {
        height: 8px;
        border-radius: 4px;
        background: #2d3446;
        Rectangle {
            x: 0;
            y: 0;
            height: 100%;
            // Guard total == 0 (no work) and clamp to a full bar.
            width: parent.width * (root.total > 0 ? min(1.0, root.done / root.total) : 0);
            border-radius: 4px;
            background: #3a6;
        }
    }
}

// One row in the adjustments sidebar: label, value readout, slider, per-control
// reset button. The `value <=> root.value` two-way binding lets a Rust write
// (per-control reset or Reset All) physically reseat the thumb. The reset button
// uses ASCII "0" — symbol glyphs tofu in Slint's default font (§1 of slint skill).
component AdjustRow inherits HorizontalLayout {
    in property <int> index;
    in property <string> label;
    in property <string> value-label;
    in property <float> minimum;
    in property <float> maximum;
    in-out property <float> value;
    in property <bool> busy;
    callback changed(float);
    callback reset();
    spacing: 8px;
    reset-btn := TouchArea {
        width: 30px;
        clicked => {
            if (!root.busy) {
                root.reset();
            }
        }
        Rectangle {
            background: root.busy ? #ffffff08 : (reset-btn.has-hover ? #ffffff22 : #ffffff11);
            border-radius: 4px;
            Text {
                text: "0";
                color: root.busy ? #666666 : white;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
    VerticalLayout {
        spacing: 2px;
        horizontal-stretch: 1;
        Text {
            text: root.label + ": " + root.value-label;
            color: #cccccc;
            font-size: 12px;
        }
        Slider {
            minimum: root.minimum;
            maximum: root.maximum;
            value <=> root.value;
            changed(v) => {
                root.changed(v);
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "imgfind";
    preferred-width: 1100px;
    preferred-height: 800px;
    background: #1f2430;

    // Properties set from Rust.
    in property <[Tile]> tiles;
    in property <int> total-items;
    in property <string> status;
    in property <bool> can-search: false;
    // Two-way-bound to the search field's text so Rust can pre-fill it on
    // session restore. Setting it does NOT trigger `search` — that callback
    // fires only on the LineEdit's `accepted` (Enter).
    in-out property <string> query-text;

    // Lightbox state set from Rust.
    in property <bool> lightbox-open: false;
    in property <image> lightbox-image;
    in property <string> lightbox-filename;
    in property <int> lightbox-index1;
    in property <int> lightbox-total;
    in property <float> lightbox-zoom: 1.0;
    in property <bool> lightbox-fit: true;
    in property <float> lightbox-fit-scale: 1.0;
    in property <length> lightbox-base-w;
    in property <length> lightbox-base-h;
    // Pan offset from centered (px). Lifted to root so the wheel callback can
    // recompute it for cursor-anchored zoom; the drag handler also writes it.
    in-out property <length> lightbox-pan-x;
    in-out property <length> lightbox-pan-y;
    callback lightbox-zoom-changed(float);
    callback lightbox-zoom-fit();
    // delta-y (px), cursor x/y and viewport w/h (all px) for cursor-anchored zoom.
    callback lightbox-zoom-wheel(float, length, length, length, length);
    callback lightbox-zoom-step(int);     // +1 = zoom in, -1 = zoom out

    // Lightbox edit-mode (image adjustments).
    in-out property <bool> edit-mode;
    in-out property <float> edit-exposure;
    in-out property <float> edit-saturation;
    in-out property <float> edit-blacks;
    in-out property <float> edit-whites;
    in-out property <float> edit-brightness;
    in-out property <float> edit-contrast;
    in property <string> edit-exposure-label: "0.00 EV";
    in property <string> edit-saturation-label: "0";
    in property <string> edit-blacks-label: "0";
    in property <string> edit-whites-label: "0";
    in property <string> edit-brightness-label: "0";
    in property <string> edit-contrast-label: "0";
    // Busy spinner: true while a slow background operation (base decode or
    // thumbnail regeneration) is in progress. The sidebar spinner is shown and
    // all controls are disabled while this is set.
    in property <bool> edit-busy;
    in property <string> edit-busy-label: "Working...";
    callback edit-toggle();
    callback edit-control-changed(int, float);
    callback edit-control-reset(int);
    callback edit-reset-all();
    callback edit-accept();

    // Detail panel state set from Rust.
    in property <bool> detail-open: false;
    in property <image> detail-image;
    in property <string> detail-filename;
    in property <string> detail-meta;
    in property <[string]> detail-tags;
    in property <string> detail-tags-joined;

    // Filter-bar properties (set from Rust; UI emits changes via callbacks below).
    in-out property <float> size-lo: 0.0;
    in-out property <float> size-hi: 1.0;
    in property <string> size-label;
    // Struct model: each chip carries its name and selected state.  Rust pushes
    // the full list; the UI calls ext-toggled(name) on click so Rust can toggle.
    in property <[{name: string, on: bool}]> type-chips;
    // 0 = Any, 1 = Has GPS, 2 = No GPS.
    in property <int> gps-mode: 0;
    // When true, hide images whose thumbnail permanently failed to generate.
    in property <bool> hide-failed: false;
    // Tag filter (set from Rust; UI emits edits via the callbacks below).
    in property <[string]> filter-tags;
    in property <string> filter-tags-joined;
    in property <bool> tag-match-and: true;   // true = AND (AllOf), false = OR
    in property <bool> tags-enabled: false;

    callback search(string);
    callback clear-search();
    callback tile-selected(int);
    callback tile-activated(int);
    callback tile-open-external(int);
    // Transient modifier state: set on left-button pointer-down, read in `clicked`.
    in-out property <bool> click-shift;
    in-out property <bool> click-ctrl;
    // Mouse click on a tile, carrying the captured modifiers (index, shift, ctrl).
    callback tile-clicked(int, bool, bool);
    callback detail-close();
    callback search-similar();
    callback detail-view-full();
    callback detail-tag-committed(string);
    callback detail-tag-remove(string);
    callback lightbox-close();
    callback lightbox-prev();
    callback lightbox-next();
    // Filter-bar callbacks.
    callback filters-changed();
    callback ext-toggled(string);
    callback gps-mode-changed(int);
    callback hide-failed-changed(bool);
    // Tag-filter callbacks.
    callback filter-tags-committed(string);
    callback filter-tag-remove(string);
    callback tag-match-toggled();
    callback tags-enabled-toggled();

    // Sort selector (set from Rust; see sort-changed / sort-dir-toggled callbacks).
    // ASCII "Asc"/"Desc" for the direction button — no arrow glyphs (tofu in Slint's default font).
    in property <[string]> sort-options;
    in-out property <int> sort-index: 0;
    in property <bool> sort-desc: false;
    callback sort-changed();
    callback sort-dir-toggled();

    // Left rail (color brushes + Most Recent buffer). Set from Rust; the rail
    // emits edits via the callbacks below.
    in property <bool> rail-visible: true;
    in property <[BrushRow]> brushes;
    in property <[string]> recent-tags;
    callback brush-committed(int, string);   // (brush index, raw text)
    callback brush-remove(int, string);      // (brush index, tag)
    callback recent-remove(string);          // remove from Most Recent buffer
    callback toggle-rail();
    callback toggle-detail();                 // peek tab: open detail for cursor / close
    callback brush-swatch-clicked(int);      // (brush index) paint brush onto selection

    // --- Tag modal + keyboard chords (T9) ---
    // The centered "Add tags" modal. When open it owns the keyboard (its
    // LineEdit types freely; Esc cancels, Enter commits).
    in property <bool> tag-modal-open: false;
    // True while ANY tag text editor (a TagEditor or the modal) is being typed
    // into. Rust drives this from a UI-thread counter of active editors; while
    // set, `capture-key-pressed` rejects keys so the editor types instead of the
    // chord machine swallowing letters like m/f/t/r/g/y/p/b.
    in property <bool> chords-suppressed: false;
    // Single key string forwarded to Rust, which holds the pending-prefix chord
    // state and decides the resulting action.
    callback key(string);
    // Modal commit (raw space-separated text) / cancel.
    callback tag-modal-commit(string);
    callback tag-modal-cancel();
    // Bumped by every TagEditor when it enters/leaves edit mode; Rust keeps the
    // active-editor count and sets `chords-suppressed`.
    callback editor-editing-changed(bool);

    // The trigger/prefix keys the chord machine cares about: backtick, the three
    // trigger letters (t/m/f) and the five brush-completion letters (r/g/y/p/b).
    // Centralized so the lightbox branch and the grid branch forward the same set.
    pure function is-chord-key(t: string) -> bool {
        return t == "`" || t == "t" || t == "m" || t == "f"
            || t == "r" || t == "g" || t == "y" || t == "p" || t == "b"
            || t == "G";
    }

    // Keyboard-navigation selection: index into `tiles` of the highlighted tile,
    // or -1 for none. Driven by Rust (mouse click + grid-nav handler).
    in property <int> selected-index: -1;
    // dir encoding: 0=Left, 1=Right, 2=Up, 3=Down. Second arg is the live column count.
    callback grid-nav(int, int);
    callback grid-open-detail();
    callback grid-open-lightbox();

    // Multi-image selection (vim-style). The statusline reports mode/count/size;
    // the callbacks are declared here for Task 4 to wire to keys (no markup
    // wiring of keys this task).
    in property <string> statusline;
    callback selection-enter-range();
    callback selection-enter-free();
    callback grid-space();
    callback grid-escape();

    // --- Background processing status (set from Rust; the worker drains its
    // progress channel on the UI thread and writes these). The `\` key toggles
    // the panel; the statusline pill mirrors `process-pill-text`. ASCII text only.
    in property <bool> process-panel-open: false;
    in property <bool> process-paused: false;
    in property <string> process-state;        // "Running" / "Paused" / "Waiting for model..." / "Idle"
    in property <string> process-pill-text;    // e.g. "Indexing 16/40" or "Done"
    in property <string> process-indexing-hint; // e.g. "12 still indexing" (empty when caught up)
    in property <int> process-thumbs300-done;
    in property <int> process-thumbs300-total;
    in property <int> process-embed-done;
    in property <int> process-embed-total;
    in property <int> process-full-done;
    in property <int> process-full-total;
    in property <int> process-overall-done;
    in property <int> process-overall-total;
    callback toggle-process-panel();
    callback toggle-process-pause();

    // Grid geometry constants.
    private property <length> tile-size: 200px;
    private property <length> tile-gap: 8px;
    private property <length> tile-stride: tile-size + tile-gap;
    // Number of columns that fit in the grid area (not root width — the panel
    // narrows the available space when open, so we bind to grid-area.width).
    // Exposed as `out` so Rust can read it for the T14 windowed loader.
    out property <int> cols: max(1, floor((grid-area.width - 16px) / tile-stride));
    // Total grid height: driven by total-items (full result set), not tiles.length
    // (the capped render window), so the scrollbar spans the complete library.
    private property <int> row-count: ceil(root.total-items / cols);
    private property <length> grid-height: row-count * tile-stride;
    // Scroll offset exposed for the T14 viewport-driven window loader, two-way
    // bound to the ScrollView below so Rust can ALSO restore it on session
    // launch (T20). NOTE the sign: viewport-y is <= 0 and grows MORE NEGATIVE as
    // you scroll down, so the Rust side negates it (`scroll_px = (-vy).max(0)`).
    in-out property <length> grid-viewport-y;
    // Visible height of the scroll viewport, for the T14 windowed loader's
    // `visible_rows` computation.
    out property <length> grid-viewport-h: grid-scroll.visible-height;
    // Lightbox content-area dimensions (window minus 36px top bar + 80px bottom bar).
    // Used by Rust to compute fit-scale after decoding an image.
    out property <length> lightbox-content-w: root.width;
    out property <length> lightbox-content-h: root.height - 36px - 80px;

    // ALL keyboard shortcuts live in ONE place: the single `app-keys` FocusScope
    // below, which wraps the whole window and uses `capture-key-pressed`. Slint
    // offers each key event to ancestors (Window down to the focused element)
    // BEFORE delivering it to whatever currently has focus, so these shortcuts
    // fire no matter which control (tile, Button, slider) was last clicked — no
    // per-scope focus juggling, no focus pulses. The only gate is the search
    // field: while it has focus we let it type (Escape blurs back to app-keys).
    forward-focus: app-keys;

    // Keep the selected tile within the scroll viewport.
    changed selected-index => {
        if (root.selected-index >= 0) {
            // Inline expressions: tile-y, tile-bottom, top, bottom.
            if (floor(root.selected-index / root.cols) * root.tile-stride < -grid-scroll.viewport-y) {
                grid-scroll.viewport-y = -(floor(root.selected-index / root.cols) * root.tile-stride);
            } else if (floor(root.selected-index / root.cols) * root.tile-stride + root.tile-size > -grid-scroll.viewport-y + grid-scroll.visible-height) {
                grid-scroll.viewport-y = -(floor(root.selected-index / root.cols) * root.tile-stride + root.tile-size - grid-scroll.visible-height);
            }
        }
    }

    // Whenever edit mode ends (via ANY path — Esc, `e`, the Edit button,
    // prev/next discard, or Accept), the `if edit-mode` adjustments sidebar is
    // torn down. The std-widgets `Slider`s in that sidebar grab keyboard focus
    // while editing, so destroying the sidebar leaves focus null — and with no
    // focused descendant, app-keys' capture-key-pressed receives nothing until
    // the next click. Re-focusing app-keys synchronously here would race the
    // teardown (the focus pulse gets clobbered in the same event-loop turn), so
    // a 1ms single-shot Timer defers the re-focus to the next tick, AFTER the
    // sidebar is gone, restoring the global keyboard owner reliably.
    changed edit-mode => {
        if (!root.edit-mode) {
            refocus-timer.running = true;
        }
    }

    // Same null-focus trap as edit-mode above, for the tag text editors (brush /
    // Most Recent / filter / detail). When a TagEditor commits, its LineEdit is
    // destroyed (`editing = false`) and focus goes null — so app-keys'
    // capture-key-pressed stops receiving keys and every shortcut dies until the
    // next click. Rust clears `chords-suppressed` as the editor leaves editing;
    // when it drops to false, reclaim focus one tick later (after the LineEdit
    // teardown) via the shared refocus-timer. The timer's guard skips the
    // re-focus if another editor/search grabbed focus in the meantime.
    changed chords-suppressed => {
        if (!root.chords-suppressed) {
            refocus-timer.running = true;
        }
    }

    app-keys := FocusScope {
        // Hold focus from startup so key events flow; capture-key-pressed then
        // intercepts them for the whole subtree regardless of inner focus.
        init => { self.focus(); }

        // Single-shot: started by the `changed edit-mode` handler above to
        // reclaim focus one tick after the edit sidebar (and its focus-stealing
        // Slider) is removed. `running` defaults to true, so it must start false.
        refocus-timer := Timer {
            interval: 1ms;
            running: false;
            triggered => {
                self.running = false;
                // Don't yank focus from a control that legitimately grabbed it in
                // the meantime (a freshly-opened tag editor, or the search field).
                if (!root.chords-suppressed && !search-input.has-focus) {
                    app-keys.focus();
                }
            }
        }

        capture-key-pressed(event) => {
            // While the search field is being typed in, let it have the keys
            // (Escape blurs it back to the app scope so navigation resumes).
            if (search-input.has-focus) {
                if (event.text == Key.Escape) {
                    app-keys.focus();
                    return accept;
                }
                return reject;
            }
            // The tag modal owns the keyboard while open: Esc cancels, every
            // other key is rejected so the modal's LineEdit types it.
            if (root.tag-modal-open) {
                if (event.text == Key.Escape) {
                    root.tag-modal-cancel();
                    return accept;
                }
                return reject;
            }
            // A tag text editor (brush / Most Recent / detail / filter editor) is
            // being typed into: let it have every key so chord letters don't get
            // stolen. Escape blurs back to app-keys so chords/nav resume.
            if (root.chords-suppressed) {
                if (event.text == Key.Escape) {
                    app-keys.focus();
                    return accept;
                }
                return reject;
            }
            // The lightbox is modal: it owns the keyboard while open. Its own
            // nav keys (Esc / h / l / arrows) win first; the tag chord keys
            // (t/m/f/`/r/g/y/p/b) are then forwarded so tagging works on the
            // lightbox image too; anything else is swallowed (modal).
            if (root.lightbox-open) {
                if (event.text == Key.Escape) {
                    // In edit mode Esc discards (exits edit mode); otherwise it
                    // closes the lightbox. Rust's edit-toggle handler discards.
                    // Focus restoration after leaving edit mode is handled
                    // centrally by the `changed edit-mode` -> refocus-timer hook
                    // (deferred past the sidebar teardown), so a second Esc then
                    // closes the lightbox. Do NOT re-focus here: a synchronous
                    // pulse in this same turn races the teardown and is dropped.
                    if (root.edit-mode) {
                        root.edit-toggle();
                    } else {
                        root.lightbox-close();
                    }
                    return accept;
                }
                // `e` toggles the adjustments (edit) sidebar.
                if (event.text == "e" || event.text == "E") {
                    root.edit-toggle();
                    return accept;
                }
                if (event.text == Key.LeftArrow || event.text == "h" || event.text == "H") {
                    root.lightbox-prev();
                    return accept;
                }
                if (event.text == Key.RightArrow || event.text == "l" || event.text == "L") {
                    root.lightbox-next();
                    return accept;
                }
                if (root.is-chord-key(event.text) && event.text != "g" && event.text != "G") {
                    root.key(event.text);
                    return accept;
                }
                // Zoom controls: 0 = fit, 1 = 100% (1:1), +/= = zoom in, - = zoom out.
                if (event.text == "0") {
                    root.lightbox-zoom-fit();
                    return accept;
                }
                if (event.text == "1") {
                    root.lightbox-zoom-changed(1.0);
                    return accept;
                }
                if (event.text == "+" || event.text == "=") {
                    root.lightbox-zoom-step(1);
                    return accept;
                }
                if (event.text == "-") {
                    root.lightbox-zoom-step(-1);
                    return accept;
                }
                // Backslash toggles the background-processing status panel.
                if (event.text == "\\") {
                    root.toggle-process-panel();
                    return accept;
                }
                return accept;
            }
            // Multi-image selection (grid-only): `v` enters Free mode, `Shift+V`
            // enters Range mode. Placed before the chord/nav blocks; `v` is
            // neither a chord nor a nav key, so order is safe — but explicit.
            if (event.text == "v" || event.text == "V") {
                if (event.modifiers.shift) {
                    root.selection-enter-range();
                } else {
                    root.selection-enter-free();
                }
                return accept;
            }
            // Tag chord keys: backtick, the t/m/f triggers, and the brush
            // completion letters. Forward to Rust, which holds the pending-prefix
            // state. None of these collide with grid nav (hjkl/arrows/Enter/Space/
            // Esc), so forwarding them here is safe; a bare brush letter with no
            // pending prefix resolves to no action in Rust.
            if (root.is-chord-key(event.text)) {
                root.key(event.text);
                return accept;
            }
            // Grid navigation.
            if (event.text == "h" || event.text == "H" || event.text == Key.LeftArrow) {
                root.grid-nav(0, root.cols);
                return accept;
            }
            if (event.text == "l" || event.text == "L" || event.text == Key.RightArrow) {
                root.grid-nav(1, root.cols);
                return accept;
            }
            if (event.text == "k" || event.text == "K" || event.text == Key.UpArrow) {
                root.grid-nav(2, root.cols);
                return accept;
            }
            if (event.text == "j" || event.text == "J" || event.text == Key.DownArrow) {
                root.grid-nav(3, root.cols);
                return accept;
            }
            if (event.text == Key.Return) {
                root.grid-open-detail();
                return accept;
            }
            if (event.text == " ") {
                root.grid-space();
                return accept;
            }
            // Esc in the grid branch: clears an active selection (else closes the
            // detail panel). Rust decides via grid-escape().
            if (event.text == Key.Escape) {
                root.grid-escape();
                return accept;
            }
            // Backslash toggles the background-processing status panel. Placed
            // after the typing/chord-suppression guards above, so it never fires
            // while a text field is focused.
            if (event.text == "\\") {
                root.toggle-process-panel();
                return accept;
            }
            return reject;
        }

        // Wrap rail+main and the bottom statusline in a VerticalLayout so the
        // 24px statusline sits below the content and the grid never hides under
        // it. The lightbox / tag-modal overlays remain later FocusScope siblings
        // so they still paint on top of everything.
        VerticalLayout {
        HorizontalLayout {
            // --- Left rail: color brushes + Most Recent buffer ---
            if root.rail-visible: Rectangle {
                width: 240px;
                background: #1a1f29;
                border-width: 1px;
                border-color: #3a4255;
                VerticalLayout {
                    padding: 10px;
                    spacing: 8px;
                    Text {
                        text: "Brushes";
                        color: #9aa4b2;
                        font-size: 13px;
                    }
                    for brush[i] in root.brushes: HorizontalLayout {
                        spacing: 6px;
                        Rectangle {
                            width: 20px;
                            height: 20px;
                            border-radius: 10px;
                            background: brush.color;
                            border-width: swatch-touch.has-hover ? 2px : 0px;
                            border-color: #ffffff;
                            Text {
                                text: brush.letter;
                                color: #fff;
                                font-size: 12px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }
                            swatch-touch := TouchArea {
                                clicked => {
                                    root.brush-swatch-clicked(i);
                                    app-keys.focus();
                                }
                            }
                        }
                        TagEditor {
                            horizontal-stretch: 1;
                            tags: brush.tags;
                            joined: brush.joined;
                            pill-color: brush.color;
                            committed-text(t) => {
                                root.brush-committed(i, t);
                            }
                            remove(tag) => {
                                root.brush-remove(i, tag);
                            }
                            editing-changed(e) => {
                                root.editor-editing-changed(e);
                            }
                        }
                    }
                    Rectangle {
                        height: 1px;
                        background: #3a4255;
                    }
                    Text {
                        text: "Most Recent";
                        color: #9aa4b2;
                        font-size: 13px;
                    }
                    TagEditor {
                        tags: root.recent-tags;
                        joined: "";
                        placeholder: "(applied tags appear here)";
                        remove(tag) => {
                            root.recent-remove(tag);
                        }
                        editing-changed(e) => {
                            root.editor-editing-changed(e);
                        }
                    }
                }
            }

            // --- Main column (search, filters, sort, grid, detail panel) ---
            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: "Clear text search";
                        enabled: root.query-text != "";
                        clicked => { root.clear-search(); app-keys.focus(); }
                    }
                    search-input := LineEdit {
                        text <=> root.query-text;
                        placeholder-text: root.can-search ? "Search images..." : "Loading model...";
                        enabled: root.can-search;
                        // Return focus to app-keys after submitting so grid keys work.
                        accepted(text) => { root.search(text); app-keys.focus(); }
                    }
                    // "N still indexing" hint while embeddings are still being
                    // generated in the background (some images aren't searchable yet).
                    if root.process-indexing-hint != "": Text {
                        text: root.process-indexing-hint;
                        color: #f2c94c;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }

                // --- Filter bar ---
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    // Size range slider + label.
                    RangeSlider {
                        width: 180px;
                        lo <=> root.size-lo;
                        hi <=> root.size-hi;
                        range-changed(lo, hi) => {
                            root.size-lo = lo;
                            root.size-hi = hi;
                            root.filters-changed();
                        }
                    }
                    Text {
                        text: root.size-label;
                        color: #9aa4b2;
                        vertical-alignment: center;
                    }

                    // File-type toggle chips (struct model: [{name, on}]).
                    for chip in root.type-chips: Rectangle {
                        width: chip-label.preferred-width + 16px;
                        height: 24px;
                        border-radius: 4px;
                        background: chip.on ? #3a6 : #2d3446;
                        border-width: 1px;
                        border-color: chip.on ? #3a6 : #3a4255;

                        chip-label := Text {
                            text: chip.name;
                            color: chip.on ? #fff : #9aa4b2;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }

                        TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => { root.ext-toggled(chip.name); }
                        }
                    }

                    // GPS 3-way control: Any / Has GPS / No GPS.
                    HorizontalLayout {
                        spacing: 2px;

                        Rectangle {
                            width: gps-any-text.preferred-width + 16px;
                            height: 24px;
                            border-radius: 4px;
                            background: root.gps-mode == 0 ? #3a6 : #2d3446;
                            border-width: 1px;
                            border-color: root.gps-mode == 0 ? #3a6 : #3a4255;
                            gps-any-text := Text {
                                text: "Any";
                                color: root.gps-mode == 0 ? #fff : #9aa4b2;
                                font-size: 12px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }
                            TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => { root.gps-mode-changed(0); }
                            }
                        }

                        Rectangle {
                            width: gps-has-text.preferred-width + 16px;
                            height: 24px;
                            border-radius: 4px;
                            background: root.gps-mode == 1 ? #3a6 : #2d3446;
                            border-width: 1px;
                            border-color: root.gps-mode == 1 ? #3a6 : #3a4255;
                            gps-has-text := Text {
                                text: "Has GPS";
                                color: root.gps-mode == 1 ? #fff : #9aa4b2;
                                font-size: 12px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }
                            TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => { root.gps-mode-changed(1); }
                            }
                        }

                        Rectangle {
                            width: gps-no-text.preferred-width + 16px;
                            height: 24px;
                            border-radius: 4px;
                            background: root.gps-mode == 2 ? #3a6 : #2d3446;
                            border-width: 1px;
                            border-color: root.gps-mode == 2 ? #3a6 : #3a4255;
                            gps-no-text := Text {
                                text: "No GPS";
                                color: root.gps-mode == 2 ? #fff : #9aa4b2;
                                font-size: 12px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }
                            TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => { root.gps-mode-changed(2); }
                            }
                        }
                    }

                    // Hide-failed toggle: exclude images whose thumbnail failed.
                    Rectangle {
                        width: hide-failed-text.preferred-width + 16px;
                        height: 24px;
                        border-radius: 4px;
                        background: root.hide-failed ? #3a6 : #2d3446;
                        border-width: 1px;
                        border-color: root.hide-failed ? #3a6 : #3a4255;
                        hide-failed-text := Text {
                            text: "Hide failed";
                            color: root.hide-failed ? #fff : #9aa4b2;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                        TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => { root.hide-failed-changed(!root.hide-failed); }
                        }
                    }
                }

                // --- Tag filter row ---
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Text {
                        text: "Tags:";
                        color: #9aa4b2;
                        vertical-alignment: center;
                    }
                    TagEditor {
                        width: 240px;
                        tags: root.filter-tags;
                        joined: root.filter-tags-joined;
                        placeholder: "filter by tags...";
                        committed-text(t) => { root.filter-tags-committed(t); }
                        remove(tag) => { root.filter-tag-remove(tag); }
                        editing-changed(e) => { root.editor-editing-changed(e); }
                    }
                    // AND/OR toggle button (ASCII text — no glyphs).
                    Rectangle {
                        width: andor-text.preferred-width + 16px;
                        height: 24px;
                        border-radius: 4px;
                        background: #2d3446;
                        border-width: 1px;
                        border-color: #3a4255;
                        andor-text := Text {
                            text: root.tag-match-and ? "AND" : "OR";
                            color: #cfd6e2;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                        TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => { root.tag-match-toggled(); }
                        }
                    }
                    Toggle {
                        on: root.tags-enabled;
                        toggled(v) => { root.tags-enabled-toggled(); }
                    }
                    Text {
                        text: "filter on";
                        color: #9aa4b2;
                        vertical-alignment: center;
                        font-size: 12px;
                    }
                }

                // --- Sort bar ---
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Text {
                        text: "Sort:";
                        color: #9aa4b2;
                        vertical-alignment: center;
                    }
                    ComboBox {
                        model: root.sort-options;
                        current-index <=> root.sort-index;
                        selected(_) => { root.sort-changed(); }
                    }
                    // ASCII "Asc"/"Desc" — no arrow glyphs (tofu in the default Slint font).
                    sort-dir-btn := TouchArea {
                        width: sort-dir-text.preferred-width + 16px;
                        height: 28px;
                        clicked => { root.sort-dir-toggled(); }
                        Rectangle {
                            background: sort-dir-btn.has-hover ? #3a4a65 : #2d3446;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: #3a4255;
                            width: 100%;
                            height: 100%;
                            sort-dir-text := Text {
                                text: root.sort-desc ? "Desc" : "Asc";
                                color: #e0e4ed;
                                font-size: 13px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                Text {
                    text: root.status;
                    color: #9aa4b2;
                    visible: root.status != "";
                }

                HorizontalLayout {
                    spacing: 0px;
                    vertical-stretch: 1;

                    // Grid area — grows to fill all available width when panel is closed.
                    grid-area := Rectangle {
                        horizontal-stretch: 1;
                        background: transparent;

                        grid-scroll := ScrollView {
                            width: 100%;
                            height: 100%;
                            viewport-height: root.grid-height;
                            viewport-width: root.cols * root.tile-stride;
                            viewport-y <=> root.grid-viewport-y;

                            for tile in root.tiles: Rectangle {
                                // Position by global index so the tile lands in the
                                // correct row/col even when the window doesn't start
                                // at 0 (T14 will deliver a non-zero-offset slice).
                                x: mod(tile.index, root.cols) * root.tile-stride;
                                y: floor(tile.index / root.cols) * root.tile-stride;
                                width: root.tile-size;
                                height: root.tile-size;
                                border-radius: 6px;
                                clip: true;
                                background: #2d3446;
                                border-width: (tile.index == root.selected-index || tile.selected) ? 3px : 0px;
                                border-color: tile.index == root.selected-index ? #3ad17a : #f2c94c;

                                Image {
                                    source: tile.image;
                                    image-fit: cover;
                                    width: 100%;
                                    height: 100%;
                                }

                                TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    pointer-event(e) => {
                                        // Capture modifiers at press (down fires before
                                        // clicked, which fires on release) so the click
                                        // handler can read shift/ctrl.
                                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                            root.click-shift = e.modifiers.shift;
                                            root.click-ctrl = e.modifiers.control;
                                        }
                                        if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                                            root.tile-open-external(tile.index);
                                        }
                                    }
                                    // Dispatch the (modifier-aware) tile click —
                                    // plain click opens detail; shift/ctrl drive
                                    // range/free selection — then return keyboard
                                    // focus to app-keys (e.g. after typing a query)
                                    // so vim/arrow navigation works immediately.
                                    clicked => {
                                        root.tile-clicked(tile.index, root.click-shift, root.click-ctrl);
                                        app-keys.focus();
                                    }
                                    double-clicked => { root.tile-activated(tile.index); }
                                }
                            }
                        }
                    }

                    // Detail panel — fixed 340 px, only present when detail-open.
                    if root.detail-open: Rectangle {
                        width: 340px;
                        background: #252b3a;

                        // Left border divider rendered as a thin child rectangle.
                        Rectangle {
                            x: 0px;
                            y: 0px;
                            width: 1px;
                            height: parent.height;
                            background: #3a4255;
                        }

                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;

                            HorizontalLayout {
                                alignment: end;
                                Button {
                                    // U+00D7 (×, Latin-1) renders in Slint's default font;
                                    // the previous ✕ (U+2715) had no glyph and showed as tofu.
                                    text: "×";
                                    clicked => { root.detail-close(); app-keys.focus(); }
                                }
                            }

                            Image {
                                source: root.detail-image;
                                image-fit: contain;
                                height: 300px;
                            }

                            Text {
                                text: root.detail-filename;
                                color: #e0e4ed;
                                font-size: 13px;
                                wrap: word-wrap;
                            }

                            Text {
                                text: root.detail-meta;
                                color: #9aa4b2;
                                font-size: 12px;
                                wrap: word-wrap;
                            }

                            Text { text: "Tags"; color: #9aa4b2; font-size: 12px; }
                            TagEditor {
                                tags: root.detail-tags;
                                joined: root.detail-tags-joined;
                                committed-text(t) => { root.detail-tag-committed(t); }
                                remove(tag) => { root.detail-tag-remove(tag); }
                                editing-changed(e) => { root.editor-editing-changed(e); }
                            }

                            Button {
                                text: "View full";
                                // Opens the lightbox for the seed image by path, not by
                                // grid index, so it stays valid after a similar-search
                                // replaces the tile grid.
                                clicked => { root.detail-view-full(); app-keys.focus(); }
                            }

                            Button {
                                text: "Search similar";
                                clicked => { root.search-similar(); app-keys.focus(); }
                            }
                        }
                    }

                    // Processing status panel — fixed 300 px, only present when
                    // process-panel-open. Reflows the grid (grid-area has
                    // horizontal-stretch: 1, so it shrinks) — it does NOT overlay,
                    // mirroring the detail panel above. Closing it does not stop
                    // the worker (Rust only flips the property).
                    if root.process-panel-open: Rectangle {
                        width: 300px;
                        background: #252b3a;

                        // Left border divider rendered as a thin child rectangle.
                        Rectangle {
                            x: 0px;
                            y: 0px;
                            width: 1px;
                            height: parent.height;
                            background: #3a4255;
                        }

                        VerticalLayout {
                            padding: 12px;
                            spacing: 10px;

                            HorizontalLayout {
                                Text {
                                    text: "Processing";
                                    color: #e0e4ed;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Button {
                                    // U+00D7 (×, Latin-1) renders; ✕ (U+2715) tofus.
                                    text: "×";
                                    clicked => { root.toggle-process-panel(); app-keys.focus(); }
                                }
                            }

                            // Bars grouped with generous inter-item spacing so each
                            // label clearly belongs to the bar directly beneath it.
                            VerticalLayout {
                                spacing: 18px;
                                vertical-stretch: 0;
                                ProcessBar {
                                    label: "Thumbnails (300px)";
                                    done: root.process-thumbs300-done;
                                    total: root.process-thumbs300-total;
                                }
                                ProcessBar {
                                    label: "Embeddings";
                                    done: root.process-embed-done;
                                    total: root.process-embed-total;
                                }
                                ProcessBar {
                                    label: "Full thumbnails";
                                    done: root.process-full-done;
                                    total: root.process-full-total;
                                }
                            }

                            // Slack lives here so the bars pack to the top while
                            // State + Pause stay pinned to the panel bottom.
                            Rectangle { vertical-stretch: 1; }

                            Text {
                                text: "State: \{root.process-state}";
                                color: #9aa4b2;
                                font-size: 12px;
                                wrap: word-wrap;
                            }

                            Button {
                                text: root.process-paused ? "Resume" : "Pause";
                                clicked => { root.toggle-process-pause(); app-keys.focus(); }
                            }
                        }
                    }
                }
            }
        }

        // --- Bottom statusline bar (always visible, full width) ---
        // ASCII-only text (Slint default font has no glyph for many symbols).
        Rectangle {
            height: 24px;
            background: #161a22;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;
                Text {
                    text: root.statusline;
                    color: #9aa4b2;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                // Spacer pushes the processing pill to the right edge.
                Rectangle { horizontal-stretch: 1; }
                // Clickable processing-status pill (ASCII text only). Toggles the
                // status panel; hidden until the worker has set its text.
                Rectangle {
                    visible: root.process-pill-text != "";
                    width: pill-text.preferred-width + 16px;
                    height: 18px;
                    border-radius: 4px;
                    background: pill-touch.has-hover ? #3a4255 : #2d3446;
                    pill-text := Text {
                        text: root.process-pill-text;
                        color: #cfd6e4;
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                    pill-touch := TouchArea {
                        clicked => { root.toggle-process-panel(); app-keys.focus(); }
                    }
                }
            }
        }
        }

        // --- Peek tabs: toggle the brush rail (left) / detail panel (right) ---
        // Children of app-keys (which spans the window), declared AFTER the main
        // layout and BEFORE the lightbox so they paint above the grid but under
        // the lightbox/modal overlays. ASCII glyphs only (chevrons tofu in the
        // default font). The left tab reuses the existing toggle-rail callback.
        Rectangle {
            width: 18px;
            height: 30px;
            x: root.rail-visible ? 240px : 0px;
            y: (parent.height - self.height) / 2;
            background: left-tab.has-hover ? #3a4255 : #2d3446;
            border-radius: 4px;
            Text {
                text: root.rail-visible ? "<" : ">";
                color: #e0e4ed;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
            left-tab := TouchArea {
                clicked => {
                    root.toggle-rail();
                    app-keys.focus();
                }
            }
        }

        Rectangle {
            width: 18px;
            height: 30px;
            x: parent.width - (root.detail-open ? 340px : 0px) - self.width;
            y: (parent.height - self.height) / 2;
            background: right-tab.has-hover ? #3a4255 : #2d3446;
            border-radius: 4px;
            Text {
                text: root.detail-open ? ">" : "<";
                color: #e0e4ed;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
            right-tab := TouchArea {
                clicked => {
                    root.toggle-detail();
                    app-keys.focus();
                }
            }
        }

        // --- Lightbox overlay (zoom/pan) ---
        // Pure visuals + TouchAreas, NO FocusScope of its own — app-keys'
        // capture-key-pressed handles all keys while it's open.
        // ASCII < / > for nav arrows (U+2039/203A ‹ › tofu in the default font).
        if root.lightbox-open: content-root := Rectangle {
            width: root.width;
            height: root.height;

            // Pan offset lives on root (lightbox-pan-x/y); reset on navigation /
            // entering fit. Mirror root properties so we can watch them.
            property <int> nav-gen: root.lightbox-index1;
            property <bool> fit-mirror: root.lightbox-fit;

            changed nav-gen => {
                root.lightbox-pan-x = 0px;
                root.lightbox-pan-y = 0px;
            }
            changed fit-mirror => {
                if (root.lightbox-fit) {
                    root.lightbox-pan-x = 0px;
                    root.lightbox-pan-y = 0px;
                }
            }

            Rectangle {
                background: #000000ee;
                width: 100%;
                height: 100%;
            }

            // Content area between the 36px top bar and 80px bottom bar.
            // When edit-mode is on the area shrinks by the sidebar width (280px)
            // so the image is never hidden behind the adjustments panel.
            content := Rectangle {
                x: 0;
                y: 36px;
                width: parent.width - (root.edit-mode ? 280px : 0px);
                height: parent.height - 36px - 80px;
                clip: true;

                // Fit view (default): centered, image-fit contain. Click closes.
                if root.lightbox-fit: Image {
                    source: root.lightbox-image;
                    image-fit: contain;
                    width: parent.width;
                    height: parent.height;
                }

                // Zoomed view: explicit size = source px * zoom, pan clamped so an
                // edge can't pull inside the viewport.
                if !root.lightbox-fit: Image {
                    source: root.lightbox-image;
                    width: root.lightbox-base-w * root.lightbox-zoom;
                    height: root.lightbox-base-h * root.lightbox-zoom;
                    x: self.width > parent.width
                        ? clamp((parent.width - self.width) / 2 + root.lightbox-pan-x,
                                parent.width - self.width, 0px)
                        : (parent.width - self.width) / 2;
                    y: self.height > parent.height
                        ? clamp((parent.height - self.height) / 2 + root.lightbox-pan-y,
                                parent.height - self.height, 0px)
                        : (parent.height - self.height) / 2;
                }

                // Wheel zoom + click-drag pan. Below the nav arrows in z-order.
                drag-touch := TouchArea {
                    width: 100%;
                    height: 100%;
                    mouse-cursor: root.lightbox-fit
                        ? MouseCursor.default
                        : (self.pressed ? MouseCursor.grabbing : MouseCursor.grab);

                    property <length> start-pan-x;
                    property <length> start-pan-y;

                    scroll-event(e) => {
                        root.lightbox-zoom-wheel(e.delta-y / 1px, self.mouse-x, self.mouse-y, self.width, self.height);
                        return accept;
                    }
                    changed pressed => {
                        if (self.pressed) {
                            self.start-pan-x = root.lightbox-pan-x;
                            self.start-pan-y = root.lightbox-pan-y;
                        }
                    }
                    moved => {
                        if (!root.lightbox-fit) {
                            root.lightbox-pan-x = self.start-pan-x + (self.mouse-x - self.pressed-x);
                            root.lightbox-pan-y = self.start-pan-y + (self.mouse-y - self.pressed-y);
                        }
                    }
                    clicked => {
                        if (root.lightbox-fit) { root.lightbox-close(); }
                    }
                }

                // Prev / next arrows pinned to the content edges.
                // ASCII < / > — ‹ › (U+2039/203A) tofu in the default font.
                prev-touch := TouchArea {
                    width: 60px;
                    height: 100%;
                    x: 0;
                    clicked => { root.lightbox-prev(); }
                    Rectangle {
                        background: prev-touch.has-hover ? #00000080 : transparent;
                        Text {
                            text: "<";
                            color: white;
                            font-size: 28px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                next-touch := TouchArea {
                    width: 60px;
                    height: 100%;
                    x: parent.width - self.width;
                    clicked => { root.lightbox-next(); }
                    Rectangle {
                        background: next-touch.has-hover ? #00000080 : transparent;
                        Text {
                            text: ">";
                            color: white;
                            font-size: 28px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Top bar: filename · counter · close (×, Latin-1 U+00D7, not tofu).
            Rectangle {
                x: 0; y: 0; width: parent.width; height: 36px;
                background: #000000cc;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 12px;
                    Text {
                        text: root.lightbox-filename;
                        color: white;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.lightbox-index1 + " of " + root.lightbox-total;
                        color: #cccccc;
                        vertical-alignment: center;
                    }
                    close-touch := TouchArea {
                        width: 28px;
                        clicked => { root.lightbox-close(); }
                        Text {
                            // × (U+00D7, Latin-1) renders in the default font;
                            // ✕ (U+2715) and ✗ (U+2717) tofu.
                            text: "×";
                            color: close-touch.has-hover ? white : #cccccc;
                            font-size: 22px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Bottom bar: Fit button · zoom slider · percentage.
            Rectangle {
                x: 0; y: parent.height - 80px; width: parent.width; height: 80px;
                background: #000000cc;
                HorizontalLayout {
                    padding: 16px;
                    spacing: 16px;
                    alignment: center;
                    fit-touch := TouchArea {
                        width: 60px;
                        clicked => { root.lightbox-zoom-fit(); }
                        Rectangle {
                            background: fit-touch.has-hover ? #ffffff22 : #ffffff11;
                            border-radius: 4px;
                            Text {
                                text: "Fit";
                                color: white;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                    // 1:1 → native resolution (zoom 1.0). Reuses zoom-changed so it
                    // exits fit and kicks off the full-res background decode.
                    one-to-one-touch := TouchArea {
                        width: 60px;
                        clicked => { root.lightbox-zoom-changed(1.0); }
                        Rectangle {
                            background: one-to-one-touch.has-hover ? #ffffff22 : #ffffff11;
                            border-radius: 4px;
                            Text {
                                text: "1:1";
                                color: white;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                    // Edit toggle: highlighted when edit-mode is active.
                    edit-touch := TouchArea {
                        width: 60px;
                        clicked => { root.edit-toggle(); }
                        Rectangle {
                            background: root.edit-mode
                                ? #4a7fc1cc
                                : (edit-touch.has-hover ? #ffffff22 : #ffffff11);
                            border-radius: 4px;
                            Text {
                                text: "Edit";
                                color: white;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                    zoom-slider := Slider {
                        minimum: 0.1;
                        maximum: 8.0;
                        value: root.lightbox-fit ? root.lightbox-fit-scale : root.lightbox-zoom;
                        width: 240px;
                        // `changed` is a named callback on Slider (not property-watch);
                        // its parameter `v` carries the new value.
                        changed(v) => { root.lightbox-zoom-changed(v); }
                    }
                    Text {
                        text: round((root.lightbox-fit ? root.lightbox-fit-scale : root.lightbox-zoom) * 100) + "%";
                        color: white;
                        vertical-alignment: center;
                        width: 56px;
                    }
                }
            }

            // Adjustments sidebar: visible only in edit-mode.
            // Anchored to the right edge; the content area (above) shrinks by
            // the same 280px when edit-mode is on so the image stays fully visible.
            if root.lightbox-open && root.edit-mode: Rectangle {
                x: parent.width - self.width;
                y: 36px;
                width: 280px;
                height: parent.height - 36px - 80px;
                background: #1e1e1eee;
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    Text {
                        text: "Adjustments";
                        color: white;
                        font-size: 16px;
                    }
                    // Six adjustment rows. Each uses a two-way `value <=> root.*`
                    // binding so a Rust write (per-control reset or Reset All)
                    // reseats the Slider thumb. Indices 0-5 match EditControl::to_i32.
                    AdjustRow {
                        index: 0;
                        label: "Exposure";
                        value-label: root.edit-exposure-label;
                        minimum: -3.0;
                        maximum: 3.0;
                        value <=> root.edit-exposure;
                        busy: root.edit-busy;
                        changed(v) => {
                            root.edit-control-changed(0, v);
                        }
                        reset => {
                            root.edit-control-reset(0);
                        }
                    }
                    AdjustRow {
                        index: 1;
                        label: "Saturation";
                        value-label: root.edit-saturation-label;
                        minimum: -100.0;
                        maximum: 100.0;
                        value <=> root.edit-saturation;
                        busy: root.edit-busy;
                        changed(v) => {
                            root.edit-control-changed(1, v);
                        }
                        reset => {
                            root.edit-control-reset(1);
                        }
                    }
                    AdjustRow {
                        index: 2;
                        label: "Blacks";
                        value-label: root.edit-blacks-label;
                        minimum: -100.0;
                        maximum: 100.0;
                        value <=> root.edit-blacks;
                        busy: root.edit-busy;
                        changed(v) => {
                            root.edit-control-changed(2, v);
                        }
                        reset => {
                            root.edit-control-reset(2);
                        }
                    }
                    AdjustRow {
                        index: 3;
                        label: "Whites";
                        value-label: root.edit-whites-label;
                        minimum: -100.0;
                        maximum: 100.0;
                        value <=> root.edit-whites;
                        busy: root.edit-busy;
                        changed(v) => {
                            root.edit-control-changed(3, v);
                        }
                        reset => {
                            root.edit-control-reset(3);
                        }
                    }
                    AdjustRow {
                        index: 4;
                        label: "Brightness";
                        value-label: root.edit-brightness-label;
                        minimum: -100.0;
                        maximum: 100.0;
                        value <=> root.edit-brightness;
                        busy: root.edit-busy;
                        changed(v) => {
                            root.edit-control-changed(4, v);
                        }
                        reset => {
                            root.edit-control-reset(4);
                        }
                    }
                    AdjustRow {
                        index: 5;
                        label: "Contrast";
                        value-label: root.edit-contrast-label;
                        minimum: -100.0;
                        maximum: 100.0;
                        value <=> root.edit-contrast;
                        busy: root.edit-busy;
                        changed(v) => {
                            root.edit-control-changed(5, v);
                        }
                        reset => {
                            root.edit-control-reset(5);
                        }
                    }
                    // Global reset: all controls to neutral 0.
                    HorizontalLayout {
                        reset-all-touch := TouchArea {
                            height: 28px;
                            clicked => {
                                if (!root.edit-busy) {
                                    root.edit-reset-all();
                                }
                            }
                            Rectangle {
                                background: root.edit-busy
                                    ? #ffffff08
                                    : (reset-all-touch.has-hover ? #ffffff22 : #ffffff11);
                                border-radius: 4px;
                                Text {
                                    text: "Reset All";
                                    color: root.edit-busy ? #666666 : white;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    // Busy indicator: shown (and animated) while edit-busy is true.
                    // Three dots pulse in sequence (ASCII-safe, no glyph characters).
                    // Each dot animates its opacity continuously; the 300ms offsets
                    // between them create a rolling wave that indicates background work.
                    if root.edit-busy: VerticalLayout {
                        spacing: 6px;
                        alignment: center;
                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            // Dot 1 — leads the pulse wave.
                            dot1 := Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: #e0e0e0;
                                opacity: dot1-pulse.v;
                            }
                            // Dot 2 — follows 300ms behind dot 1.
                            dot2 := Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: #e0e0e0;
                                opacity: dot2-pulse.v;
                            }
                            // Dot 3 — follows 300ms behind dot 2.
                            dot3 := Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: #e0e0e0;
                                opacity: dot3-pulse.v;
                            }
                        }
                        Text {
                            text: root.edit-busy-label;
                            color: #cccccc;
                            font-size: 12px;
                            horizontal-alignment: center;
                        }
                    }
                    // Flexible spacer pushes "Accept Edits" to the bottom.
                    Rectangle { vertical-stretch: 1; }
                    accept-touch := TouchArea {
                        height: 32px;
                        // Disabled while busy: gate click and dim the button.
                        clicked => {
                            if (!root.edit-busy) { root.edit-accept(); }
                        }
                        Rectangle {
                            background: root.edit-busy
                                ? #ffffff08
                                : (accept-touch.has-hover ? #ffffff22 : #ffffff11);
                            border-radius: 4px;
                            Text {
                                text: "Accept Edits";
                                color: root.edit-busy ? #666666 : white;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                // Pulse-animation drivers for the three-dot busy indicator.
                // Declared as siblings to the VerticalLayout so they persist
                // whether or not the `if edit-busy` branch is shown; Slint
                // keeps animating the properties regardless of visibility.
                // Each driver runs from 0.25→1.0→0.25 over 900ms, repeating
                // infinitely (iteration-count: -1). The 300ms stagger between
                // drivers gives the rolling-wave effect.
                dot1-pulse := Rectangle {
                    property <float> v: 0.25;
                    width: 0; height: 0;
                    animate v { duration: 900ms; iteration-count: -1; easing: ease-in-out; }
                    init => { self.v = 1.0; }
                }
                dot2-pulse := Rectangle {
                    property <float> v: 1.0;
                    width: 0; height: 0;
                    animate v { duration: 900ms; iteration-count: -1; easing: ease-in-out; }
                    init => { self.v = 0.25; }
                }
                dot3-pulse := Rectangle {
                    property <float> v: 0.25;
                    width: 0; height: 0;
                    animate v { duration: 900ms; iteration-count: -1; easing: ease-in-out; }
                    init => { self.v = 1.0; }
                }
            }
        }

        // --- Tag modal overlay ---
        // Centered "Add tags" prompt. The backdrop click cancels; the LineEdit
        // grabs focus on init and types freely (capture-key-pressed's
        // tag-modal-open branch rejects keys so the field receives them). Commit
        // (Enter) and cancel (Esc / backdrop) both return focus to app-keys so
        // chords/nav resume.
        if root.tag-modal-open: Rectangle {
            width: root.width;
            height: root.height;
            background: #000000cc;

            TouchArea {
                width: 100%;
                height: 100%;
                clicked => { root.tag-modal-cancel(); app-keys.focus(); }
            }

            Rectangle {
                width: 420px;
                height: 90px;
                background: #252b3a;
                border-radius: 8px;
                border-width: 1px;
                border-color: #3a4255;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;

                VerticalLayout {
                    padding: 14px;
                    spacing: 8px;
                    Text {
                        text: "Add tags (space-separated)";
                        color: #cfd6e2;
                        font-size: 13px;
                    }
                    modal-input := LineEdit {
                        placeholder-text: "beach sunset ...";
                        init => { self.focus(); }
                        accepted(t) => { root.tag-modal-commit(t); app-keys.focus(); }
                    }
                }
            }
        }
    }
}
