import { LineEdit, Button, ScrollView } from "std-widgets.slint";

export struct Tile {
    path: string,
    image: image,
    size-kb: int,
}

export component MainWindow inherits Window {
    title: "imgfind";
    preferred-width: 1100px;
    preferred-height: 800px;
    background: #1f2430;

    // Properties set from Rust.
    in property <[Tile]> tiles;
    in property <string> status;
    in property <bool> show-load-more;
    in property <bool> can-search: false;

    // Lightbox state set from Rust.
    in property <bool> lightbox-open: false;
    in property <image> lightbox-image;

    // Detail panel state set from Rust.
    in property <bool> detail-open: false;
    in property <image> detail-image;
    in property <string> detail-filename;
    in property <string> detail-meta;

    callback search(string);
    callback load-more();
    callback tile-selected(int);
    callback tile-activated(int);
    callback tile-open-external(int);
    callback detail-close();
    callback search-similar();
    callback detail-view-full();
    callback lightbox-close();
    callback lightbox-prev();
    callback lightbox-next();

    // Grid geometry constants.
    private property <length> tile-size: 200px;
    private property <length> tile-gap: 8px;
    private property <length> tile-stride: tile-size + tile-gap;
    // Number of columns that fit in the grid area (not root width — the panel
    // narrows the available space when open, so we bind to grid-area.width).
    private property <int> cols: max(1, floor((grid-area.width - 16px) / tile-stride));
    // Total grid height: enough rows * stride.
    private property <int> row-count: ceil(tiles.length / cols);
    private property <length> grid-height: row-count * tile-stride;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 8px;
            LineEdit {
                placeholder-text: root.can-search ? "Search images..." : "Loading model...";
                enabled: root.can-search;
                accepted(text) => { root.search(text); }
            }
        }

        Text {
            text: root.status;
            color: #9aa4b2;
            visible: root.status != "";
        }

        HorizontalLayout {
            spacing: 0px;
            vertical-stretch: 1;

            // Grid area — grows to fill all available width when panel is closed.
            grid-area := Rectangle {
                horizontal-stretch: 1;
                background: transparent;

                ScrollView {
                    width: 100%;
                    height: 100%;
                    viewport-height: root.grid-height + (root.show-load-more ? 60px : 0px);
                    viewport-width: root.cols * root.tile-stride;

                    for tile[i] in root.tiles: Rectangle {
                        x: mod(i, root.cols) * root.tile-stride;
                        y: floor(i / root.cols) * root.tile-stride;
                        width: root.tile-size;
                        height: root.tile-size;
                        border-radius: 6px;
                        clip: true;
                        background: #2d3446;

                        Image {
                            source: tile.image;
                            image-fit: cover;
                            width: 100%;
                            height: 100%;
                        }

                        TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => { root.tile-selected(i); }
                            double-clicked => { root.tile-activated(i); }
                            pointer-event(e) => {
                                if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                                    root.tile-open-external(i);
                                }
                            }
                        }
                    }

                    if root.show-load-more: Button {
                        x: 0px;
                        y: root.grid-height + 8px;
                        text: "Load more";
                        clicked => { root.load-more(); }
                    }
                }
            }

            // Detail panel — fixed 340 px, only present when detail-open.
            if root.detail-open: Rectangle {
                width: 340px;
                background: #252b3a;

                // Left border divider rendered as a thin child rectangle.
                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: 1px;
                    height: parent.height;
                    background: #3a4255;
                }

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    HorizontalLayout {
                        alignment: end;
                        Button {
                            // U+00D7 (×, Latin-1) renders in Slint's default font;
                            // the previous ✕ (U+2715) had no glyph and showed as tofu.
                            text: "×";
                            clicked => { root.detail-close(); }
                        }
                    }

                    Image {
                        source: root.detail-image;
                        image-fit: contain;
                        height: 300px;
                    }

                    Text {
                        text: root.detail-filename;
                        color: #e0e4ed;
                        font-size: 13px;
                        wrap: word-wrap;
                    }

                    Text {
                        text: root.detail-meta;
                        color: #9aa4b2;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    Button {
                        text: "View full";
                        // Opens the lightbox for the seed image by path, not by
                        // grid index, so it stays valid after a similar-search
                        // replaces the tile grid.
                        clicked => { root.detail-view-full(); }
                    }

                    Button {
                        text: "Search similar";
                        clicked => { root.search-similar(); }
                    }
                }
            }
        }
    }

    // --- Lightbox overlay ---
    if root.lightbox-open: Rectangle {
        width: root.width;
        height: root.height;
        background: #000000dd;

        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { root.lightbox-close(); }
        }

        Image {
            source: root.lightbox-image;
            image-fit: contain;
            width: 90%;
            height: 90%;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }

        HorizontalLayout {
            width: 100%;
            height: 100%;
            alignment: space-between;

            Button {
                text: "‹";
                clicked => { root.lightbox-prev(); }
            }

            Button {
                text: "›";
                clicked => { root.lightbox-next(); }
            }
        }

        forward-focus: lb-keys;
        lb-keys := FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.lightbox-close();
                    accept
                } else if (event.text == Key.LeftArrow) {
                    root.lightbox-prev();
                    accept
                } else if (event.text == Key.RightArrow) {
                    root.lightbox-next();
                    accept
                } else {
                    reject
                }
            }
        }
    }

    // Top-level key handler: Escape closes the detail panel when the lightbox
    // is not open (the lightbox's own lb-keys FocusScope owns Escape when open).
    forward-focus: main-keys;
    main-keys := FocusScope {
        key-pressed(event) => {
            if (root.detail-open && !root.lightbox-open && event.text == Key.Escape) {
                root.detail-close();
                accept
            } else {
                reject
            }
        }
    }
}
