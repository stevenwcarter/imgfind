// Text <-> pills tag editor.
//
// Display state: shows pills, one per tag, wrapped onto multiple rows so they
// never run off the right edge. Click anywhere on a pill to remove it; click the
// empty background to enter editing mode.
//
// Editing state: a LineEdit pre-filled from `joined` (space-joined tags, set
// by Rust). Commits raw text via committed-text(string) on Enter OR focus
// loss; Rust is responsible for splitting on whitespace and deduplicating.
import { LineEdit } from "std-widgets.slint";
import { TagWrap } from "tag_wrap.slint";

export component TagEditor inherits Rectangle {
    in property <[string]> tags;
    in property <string> joined;          // space-joined tags, set by Rust
    in property <string> placeholder: "add tags...";
    in property <color> pill-color: #3d4663;
    callback committed-text(string);      // raw text; Rust splits + dedupes
    callback remove(string);
    // Fired whenever this editor enters/leaves text-edit mode. The root window
    // listens so it can suppress keyboard chord forwarding while a tag field is
    // being typed into (otherwise letters like m/f/t/r are stolen by chords).
    callback editing-changed(bool);

    property <bool> editing: false;
    changed editing => { root.editing-changed(self.editing); }

    // Pills packed into rows that fit the editor's current width. Geometry is
    // reactive, so this recomputes whenever `self.width` changes (e.g. a future
    // drag-to-resize of the panels).
    property <[[string]]> rows: TagWrap.rows(root.tags, self.width);

    // Grow to fit the wrapped rows in display mode; fixed height while editing.
    // Each row is 20px + 4px spacing = 24px; +4px for layout padding remainder.
    height: root.editing ? 28px : max(28px, root.rows.length * 24px + 4px);
    border-radius: 4px;
    background: #232838;
    border-width: 1px;
    border-color: #3a4255;
    // Defense-in-depth: even if the Rust width estimate is slightly off, a pill
    // can never visibly overflow off-screen (the symptom this change kills).
    clip: true;

    // --- Display state: pills + click-to-edit background ---
    if !root.editing: Rectangle {
        // First child so pills (rendered after, on top) win their own clicks.
        TouchArea { clicked => { root.editing = true; } }
        VerticalLayout {
            padding: 4px;
            spacing: 4px;
            alignment: start;
            for row in root.rows: HorizontalLayout {
                spacing: 4px;
                alignment: start;
                for tag in row: Rectangle {
                    width: pill-text.preferred-width + 18px;
                    height: 20px;
                    border-radius: 10px;
                    background: root.pill-color;
                    pill-text := Text {
                        text: tag;
                        color: #fff;
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                    TouchArea { clicked => { root.remove(tag); } }
                }
            }
        }
    }

    // --- Editing state: LineEdit pre-filled from `joined` ---
    if root.editing: LineEdit {
        placeholder-text: root.placeholder;
        init => { self.text = root.joined; self.focus(); }
        // Signal "leaving edit" BEFORE committed-text. committed-text triggers Rust
        // to rebuild the rail/tag models, which destroys this very element — so the
        // `changed editing` notification from `editing = false` below would never be
        // delivered, leaving the window's chords-suppressed flag stuck on (keyboard
        // shortcuts dead). The direct callback runs synchronously while we're alive.
        accepted(t) => { root.editing-changed(false); root.editing = false; root.committed-text(t); }
        changed has-focus => {
            if (!self.has-focus) {
                root.editing-changed(false);
                root.editing = false;
                root.committed-text(self.text);
            }
        }
    }
}
