import { ScrollView } from "std-widgets.slint";

export struct RecentRow {
    name: string,
    path: string,
    when: string,
    root: string,
}

export component MainWindow inherits Window {
    title: "imgfind";
    preferred-width: 820px;
    preferred-height: 600px;
    background: #1e1e1e;

    in property <[RecentRow]> recents;
    in property <string> view: "home";
    in property <string> status-line;
    in property <string> log-text;
    in property <bool> indexing: false;
    in property <bool> can-open-indexed: false;
    in property <string> ask-existing-root;

    callback open-root(string);
    callback open-other();
    callback start-index();
    callback confirm-index(bool);
    callback back-home();
    callback open-indexed();

    // ── Home view ──────────────────────────────────────────────────────────
    if (root.view == "home") : Rectangle {
        width: 100%;
        height: 100%;

        VerticalLayout {
            padding: 24px;
            spacing: 16px;

            // Header
            Text {
                text: "imgfind";
                color: #ffffff;
                font-size: 28px;
                font-weight: 700;
                horizontal-alignment: left;
            }

            // Divider
            Rectangle {
                height: 1px;
                background: #3a3a3a;
            }

            // Recents list
            Rectangle {
                vertical-stretch: 1;

                if (root.recents.length == 0) : Text {
                    text: "No recent libraries";
                    color: #888888;
                    font-size: 14px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }

                if (root.recents.length > 0) : ScrollView {
                    width: 100%;
                    height: 100%;

                    VerticalLayout {
                        width: parent.width;
                        spacing: 2px;

                        for row[idx] in root.recents : recents-item := Rectangle {
                            height: 56px;
                            width: 100%;
                            background: recents-touch.has-hover ? #2a2a2a : transparent;
                            border-radius: 4px;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                padding-top: 8px;
                                padding-bottom: 8px;
                                spacing: 8px;
                                alignment: space-between;

                                VerticalLayout {
                                    spacing: 2px;
                                    vertical-stretch: 1;
                                    alignment: center;

                                    Text {
                                        text: row.name;
                                        color: #ffffff;
                                        font-size: 14px;
                                        font-weight: 600;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: row.path;
                                        color: #888888;
                                        font-size: 12px;
                                        overflow: elide;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;

                                    Text {
                                        text: row.when;
                                        color: #888888;
                                        font-size: 12px;
                                        horizontal-alignment: right;
                                    }
                                }

                                open-btn := Rectangle {
                                    width: 64px;
                                    height: 32px;
                                    background: open-touch.has-hover ? #5aaeFF : #4a9eff;
                                    border-radius: 4px;

                                    Text {
                                        text: "Open";
                                        color: #ffffff;
                                        font-size: 13px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: 100%;
                                        height: 100%;
                                    }

                                    open-touch := TouchArea {
                                        width: 100%;
                                        height: 100%;
                                        clicked => { root.open-root(row.root); }
                                    }
                                }
                            }

                            recents-touch := TouchArea {
                                width: 100%;
                                height: 100%;
                                z: -1;
                            }
                        }
                    }
                }
            }

            // Bottom action buttons
            HorizontalLayout {
                spacing: 12px;
                alignment: end;

                other-btn := Rectangle {
                    width: 180px;
                    height: 36px;
                    background: other-touch.has-hover && !root.indexing ? #2a2a2a : #222222;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: #3a3a3a;
                    opacity: root.indexing ? 0.4 : 1.0;

                    Text {
                        text: "Open other folder...";
                        color: #cccccc;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }

                    other-touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        enabled: !root.indexing;
                        clicked => { root.open-other(); }
                    }
                }

                index-btn := Rectangle {
                    width: 160px;
                    height: 36px;
                    background: index-touch.has-hover && !root.indexing ? #5aaeFF : #4a9eff;
                    border-radius: 4px;
                    opacity: root.indexing ? 0.4 : 1.0;

                    Text {
                        text: "Index a folder...";
                        color: #ffffff;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }

                    index-touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        enabled: !root.indexing;
                        clicked => { root.start-index(); }
                    }
                }
            }
        }
    }

    // ── Index view ─────────────────────────────────────────────────────────
    if (root.view == "index") : Rectangle {
        width: 100%;
        height: 100%;

        VerticalLayout {
            padding: 24px;
            spacing: 16px;

            // Header row
            HorizontalLayout {
                spacing: 12px;
                alignment: space-between;

                Text {
                    text: "Index folder";
                    color: #ffffff;
                    font-size: 24px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                back-btn := Rectangle {
                    width: 72px;
                    height: 32px;
                    background: back-touch.has-hover && !root.indexing ? #2a2a2a : #222222;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: #3a3a3a;
                    opacity: root.indexing ? 0.4 : 1.0;

                    Text {
                        text: "< Back";
                        color: #cccccc;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }

                    back-touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        enabled: !root.indexing;
                        clicked => { root.back-home(); }
                    }
                }
            }

            // Divider
            Rectangle {
                height: 1px;
                background: #3a3a3a;
            }

            // Library choice buttons (shown before indexing starts)
            if (root.ask-existing-root != "") : Rectangle {
                height: 72px;
                background: #2a2a2a;
                border-radius: 6px;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    Text {
                        text: "Existing library found at: " + root.ask-existing-root;
                        color: #cccccc;
                        font-size: 12px;
                        overflow: elide;
                    }

                    HorizontalLayout {
                        spacing: 10px;

                        add-existing-btn := Rectangle {
                            horizontal-stretch: 1;
                            height: 30px;
                            background: add-touch.has-hover && !root.indexing ? #3a3a3a : #2e2e2e;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: #4a9eff;
                            opacity: root.indexing ? 0.4 : 1.0;

                            Text {
                                text: "Add to existing library";
                                color: #4a9eff;
                                font-size: 12px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }

                            add-touch := TouchArea {
                                width: 100%;
                                height: 100%;
                                enabled: !root.indexing;
                                clicked => { root.confirm-index(false); }
                            }
                        }

                        create-new-btn := Rectangle {
                            horizontal-stretch: 1;
                            height: 30px;
                            background: create-touch.has-hover && !root.indexing ? #5aaeFF : #4a9eff;
                            border-radius: 4px;
                            opacity: root.indexing ? 0.4 : 1.0;

                            Text {
                                text: "Create new library here";
                                color: #ffffff;
                                font-size: 12px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }

                            create-touch := TouchArea {
                                width: 100%;
                                height: 100%;
                                enabled: !root.indexing;
                                clicked => { root.confirm-index(true); }
                            }
                        }
                    }
                }
            }

            if (root.ask-existing-root == "") : Rectangle {
                height: 44px;

                create-only-btn := Rectangle {
                    width: 200px;
                    height: 36px;
                    background: create-only-touch.has-hover && !root.indexing ? #5aaeFF : #4a9eff;
                    border-radius: 4px;
                    opacity: root.indexing ? 0.4 : 1.0;

                    Text {
                        text: "Create library here";
                        color: #ffffff;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }

                    create-only-touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        enabled: !root.indexing;
                        clicked => { root.confirm-index(true); }
                    }
                }
            }

            // Log pane
            Rectangle {
                vertical-stretch: 1;
                background: #111111;
                border-radius: 4px;
                clip: true;

                // Wrap in a layout to provide padding (padding on TextInput has no effect).
                HorizontalLayout {
                    padding: 8px;
                    TextInput {
                        text: root.log-text;
                        color: #cccccc;
                        font-size: 12px;
                        font-family: "monospace";
                        read-only: true;
                        wrap: word-wrap;
                    }
                }
            }

            // Status line
            Text {
                text: root.status-line;
                color: #888888;
                font-size: 12px;
                horizontal-alignment: left;
            }

            // Open library button (visible only when indexing is complete)
            if (root.can-open-indexed) : open-indexed-btn := Rectangle {
                height: 36px;
                background: open-indexed-touch.has-hover ? #5aaeFF : #4a9eff;
                border-radius: 4px;

                Text {
                    text: "Open this library";
                    color: #ffffff;
                    font-size: 13px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }

                open-indexed-touch := TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => { root.open-indexed(); }
                }
            }
        }
    }
}
